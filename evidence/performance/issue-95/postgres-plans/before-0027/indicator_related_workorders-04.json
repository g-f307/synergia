  "sample": 4,
  "sql": "SELECT w.workorder_number, e.started_at\n            FROM synergia.workorders w\n            JOIN synergia.executions e ON e.id = w.execution_id\n            WHERE e.status IN ('completed', 'completed_with_errors') AND e.organization_id = %s\n            ORDER BY e.started_at DESC, w.workorder_number DESC\n            LIMIT 25 OFFSET 0",
