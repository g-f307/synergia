# Production is a contract template, not an authorization to deploy.
# Copy to a protected configuration source and replace every CHANGE_ME value.
# It requires HTTPS and the approved corporate identity adapter and secrets.
SYNERGIA_ENV=production
SYNERGIA_IMAGE_TAG=CHANGE_ME_IMMUTABLE_TAG

POSTGRES_DB=synergia
POSTGRES_USER=synergia
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
BACKEND_PORT=8000
WEB_PORT=8080

SYNERGIA_API_ORIGIN=https://CHANGE_ME_API_HOST
AUTH_ALLOWED_ORIGINS=https://CHANGE_ME_WEB_HOST

SYNERGIA_LOCAL_AUTH_ENABLED=false
AUTH_IDENTITY_PROVIDER=corporate
AUTH_CORPORATE_ISSUER=https://CHANGE_ME_IDENTITY_HOST
AUTH_CORPORATE_DISCOVERY_URL=https://CHANGE_ME_IDENTITY_HOST/.well-known/openid-configuration
AUTH_CORPORATE_AUDIENCE=CHANGE_ME
AUTH_CORPORATE_CLIENT_ID=CHANGE_ME
AUTH_CORPORATE_CLIENT_SECRET_FILE=/run/secrets/identity-client
AUTH_CORPORATE_MAPPING_FILE=/run/secrets/identity-mapping.json
AUTH_CORPORATE_REQUIRE_MFA=true
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_BYTES
AUTH_JWT_ISSUER=synergia-production
AUTH_JWT_AUDIENCE=synergia-api
AUTH_REFRESH_COOKIE_SECURE=true
RATE_LIMIT_KEY_SECRET=CHANGE_ME_AT_LEAST_32_BYTES

INGESTION_ALLOWED_SHEETS=CHANGE_ME_EXACT_ALLOWED_SHEETS
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=disabled
OBSERVABILITY_LOG_LEVEL=INFO
