# Copy to a private file outside Git and replace every CHANGE_ME value.
SYNERGIA_ENV=homologation
SYNERGIA_IMAGE_TAG=CHANGE_ME_IMMUTABLE_TAG

POSTGRES_DB=synergia
POSTGRES_USER=synergia
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
BACKEND_PORT=8000
WEB_PORT=8080

SYNERGIA_API_ORIGIN=http://CHANGE_ME_API_HOST:8000
AUTH_ALLOWED_ORIGINS=http://CHANGE_ME_WEB_HOST:8080

# Temporary local authentication is permitted in assisted homologation only.
SYNERGIA_LOCAL_AUTH_ENABLED=true
AUTH_LOCAL_LOGIN_EXPIRES_AT=CHANGE_ME_ISO_8601_WITH_TIMEZONE
AUTH_IDENTITY_PROVIDER=local
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_BYTES
AUTH_JWT_ISSUER=synergia-homologation
AUTH_JWT_AUDIENCE=synergia-api
AUTH_REFRESH_COOKIE_SECURE=false
RATE_LIMIT_KEY_SECRET=CHANGE_ME_AT_LEAST_32_BYTES

INGESTION_ALLOWED_SHEETS=CHANGE_ME_EXACT_ALLOWED_SHEETS
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=disabled
OBSERVABILITY_LOG_LEVEL=INFO
