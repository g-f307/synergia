POSTGRES_DB=synergia
POSTGRES_USER=synergia
POSTGRES_PASSWORD=synergia-local-only
POSTGRES_PORT=5432
BACKEND_PORT=8000
WEB_PORT=8080
SYNERGIA_IMAGE_TAG=local
SYNERGIA_API_ORIGIN=http://localhost:8000
MIGRATION_BASELINE_THROUGH=
DATABASE_URL=postgresql://synergia:synergia-local-only@localhost:5432/synergia
IMPORT_STORAGE_DIR=./data/imports
UPLOAD_ALLOWED_EXTENSIONS=csv,json,xlsx
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_ARCHIVE_ENTRIES=2000
UPLOAD_MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
UPLOAD_MAX_COMPRESSION_RATIO=100
UPLOAD_REJECTED_RETENTION_HOURS=24
INGESTION_MAX_SHEETS=64
INGESTION_MAX_ROWS=1048576
INGESTION_MAX_COLUMNS=16384
INGESTION_MAX_CELLS=2000000
INGESTION_MAX_FORMULAS=2000000
INGESTION_MAX_MEMORY_BYTES=1073741824
INGESTION_MAX_OPEN_BYTES=33554432
INGESTION_MAX_FILES=10
INGESTION_MAX_SECONDS=300
# A fonte WO Status tem padrão próprio medido (900 s); só o sufixo a altera.
# INGESTION_MAX_SECONDS_WO_STATUS=900
INGESTION_MAX_ISSUES=250000
INGESTION_PROGRESS_INTERVAL=10000
# Vazio nao autoriza nenhuma aba XLSX. Use * apenas com dados sinteticos locais;
# em homologacao liste as abas do contrato separadas por | .
INGESTION_ALLOWED_SHEETS=*
# A fonte WO Status usa por padrão as abas do contrato do adapter; esta variável
# apenas restringe (nomes separados por |).
# INGESTION_ALLOWED_SHEETS_WO_STATUS=NFP|OWM SN|CTNR STATUS
SYNERGIA_ENV=development
SYNERGIA_LOCAL_AUTH_ENABLED=false
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_SIGNING_KEY=
AUTH_JWT_ISSUER=synergia-local
AUTH_JWT_AUDIENCE=synergia-api
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_IDLE_HOURS=8
AUTH_REFRESH_ABSOLUTE_HOURS=24
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_LIMIT=120
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_REPROCESS_LIMIT=10
RATE_LIMIT_REPROCESS_WINDOW_SECONDS=300
RATE_LIMIT_REPORT_GENERATE_LIMIT=20
RATE_LIMIT_REPORT_GENERATE_WINDOW_SECONDS=300
RATE_LIMIT_REPORT_EXPORT_LIMIT=60
RATE_LIMIT_REPORT_EXPORT_WINDOW_SECONDS=60
RATE_LIMIT_DECISION_LIMIT=30
RATE_LIMIT_DECISION_WINDOW_SECONDS=60
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=disabled
EMAIL_FROM_ADDRESS=
EMAIL_CAPTURE_PATH=./data/email-capture/messages.jsonl
EMAIL_BATCH_SIZE=50
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_SECONDS=60
EMAIL_CONSOLIDATION_SECONDS=60
# SMTP transport configuration (generic; channel stays disabled by default).
# Explicit allowlist of individual mailboxes, comma-separated; no wildcards.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TLS_MODE=starttls
EMAIL_SMTP_TIMEOUT_SECONDS=15
EMAIL_SMTP_AUTH_MODE=password
EMAIL_SMTP_USERNAME=
# Configure exactly one secret source; never commit actual credentials.
# In Compose these two variables reach only the email-worker, never the API.
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_PASSWORD_FILE=
EMAIL_SMTP_ALLOWED_RECIPIENTS=
# Optional docker-compose.smtp.yml: private file outside the repository.
# The container reads it as /run/secrets/smtp_password (UID 10001 needs access).
EMAIL_SMTP_SECRET_PATH=
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_METRICS_TOKEN=
OBSERVABILITY_PROBE_TIMEOUT_SECONDS=2
OBSERVABILITY_WORKER_STALE_SECONDS=300
OBSERVABILITY_QUEUE_DEGRADED_SECONDS=300
DATA_OPERATIONS_ACTOR=synergia-operator
PROFILE_AVATAR_STORAGE_ROOT=./.data/avatars

# Total Decision: apenas Sheet1 é permitida pelo contrato, inclusive com * global.
# INGESTION_ALLOWED_SHEETS_TOTAL_DECISION=Sheet1
# Limites globais se aplicam; sufixos _TOTAL_DECISION podem restringi-los.
