{
  "format_version": "1.0.0",
  "issue": 169,
  "approved_fields": [
    "id",
    "occurred_at",
    "organization_id",
    "actor_id",
    "actor_type",
    "action",
    "resource_type",
    "resource_id",
    "outcome",
    "correlation_id",
    "metadata",
    "origin"
  ],
  "metadata_fields": [
    "version",
    "state_version",
    "record_count",
    "artifact_count",
    "duration_ms",
    "attempt_number",
    "event_count",
    "consent",
    "is_active",
    "from_state",
    "to_state",
    "format",
    "fallback",
    "model",
    "model_digest",
    "executor",
    "operation",
    "tool"
  ],
  "sources": [
    {
      "table": "audit_events",
      "id_prefix": "execution",
      "organization": "organization from executions",
      "actions": [
        "execution_started",
        "execution_transitioned",
        "execution_completed",
        "execution_failed",
        "file_accepted",
        "file_rejected",
        "pipeline_finished",
        "processing_unit_persisted",
        "processing_persistence_failed",
        "reprocessing_requested",
        "artifact.export_prepared"
      ],
      "emitters": [
        "database/migrations/0009_execution_lifecycle.sql",
        "database/migrations/0010_secure_upload_quarantine.sql",
        "backend/app/imports.py",
        "backend/app/persistence.py",
        "backend/app/queries.py",
        "backend/app/execution_monitoring.py"
      ]
    },
    {
      "table": "identity_access_events",
      "id_prefix": "identity",
      "organization": "explicit organization or global",
      "actions": [
        "auth.*",
        "user.*",
        "access.*",
        "profile.*",
        "authorization.denied",
        "approval.*",
        "feedback.*"
      ],
      "emitters": [
        "backend/app/auth/repository.py",
        "backend/app/users.py",
        "backend/app/access_control.py",
        "backend/app/profile.py",
        "backend/app/authorization.py",
        "backend/app/approvals.py",
        "database/migrations/0035_create_product_feedback.sql"
      ]
    },
    {
      "table": "report_events",
      "id_prefix": "report",
      "organization": "organization from report_versions",
      "actions": [
        "report.generation_*",
        "report.consulted",
        "report.exported"
      ],
      "emitters": [
        "backend/app/reports.py"
      ]
    },
    {
      "table": "approval_events",
      "id_prefix": "approval",
      "organization": "explicit organization",
      "actions": [
        "approval.created",
        "approval.submitted",
        "approval.assigned",
        "approval.reassigned",
        "approval.approved",
        "approval.rejected",
        "approval.returned",
        "approval.resubmitted"
      ],
      "emitters": [
        "backend/app/approvals.py"
      ]
    },
    {
      "table": "notification_events",
      "id_prefix": "notification",
      "organization": "organization from notification; missing notification is global",
      "actions": [
        "notification.created",
        "notification.delivered",
        "notification.consolidated",
        "notification.suppressed",
        "notification.delivery_failed",
        "notification.read"
      ],
      "emitters": [
        "database/migrations/0021_create_internal_notifications.sql",
        "database/migrations/0030_create_notification_template_administration.sql"
      ]
    },
    {
      "table": "notification_template_events",
      "id_prefix": "template",
      "organization": "global",
      "actions": [
        "template.draft_created",
        "template.draft_updated",
        "template.published",
        "template.deactivated"
      ],
      "emitters": [
        "backend/app/notification_templates.py"
      ]
    },
    {
      "table": "data_operation_events",
      "id_prefix": "data_operation",
      "organization": "global",
      "actions": [
        "data.backup",
        "data.restore",
        "data.verification",
        "data.retention"
      ],
      "emitters": [
        "backend/app/data_operations.py"
      ]
    },
    {
      "table": "approval_policy_activation_events",
      "id_prefix": "policy",
      "organization": "global",
      "actions": [
        "approval.policy_activation"
      ],
      "emitters": [
        "database/migrations/0023_create_human_approvals.sql"
      ]
    },
    {
      "table": "email_delivery_attempts",
      "id_prefix": "email_attempt",
      "organization": "organization from delivery and notification",
      "actions": [
        "email.started",
        "email.sent",
        "email.retry",
        "email.failed"
      ],
      "emitters": [
        "backend/app/email_delivery.py"
      ]
    },
    {
      "table": "email_delivery_reconciliations",
      "id_prefix": "email_reconciliation",
      "organization": "organization from delivery and notification",
      "actions": [
        "email.reconciled"
      ],
      "emitters": [
        "backend/app/email_reconciliation.py"
      ]
    },
    {
      "table": "audit_export_events",
      "id_prefix": "audit_export",
      "organization": "authorized organization or global-only",
      "actions": [
        "audit.export_requested",
        "audit.export_succeeded",
        "audit.export_failed"
      ],
      "emitters": [
        "backend/app/audit.py"
      ]
    },
    {
      "table": "observability_events",
      "id_prefix": "llm",
      "organization": "global synthetic quality demonstrator; no business organization inferred",
      "actions": [
        "llm.requested",
        "llm.completed",
        "llm.failed"
      ],
      "emitters": [
        "backend/app/model_audit.py"
      ],
      "implementation_status": "implemented",
      "limitations": [
        "No autonomous tools or business-data inference; tokens not exposed by current runtime adapter.",
        "No prompt, response, response hash, cells or evidence in audit events."
      ]
    },
    {
      "table": "rate_limit_events",
      "id_prefix": "security_rate",
      "organization": "global; never infer organization from HMAC key",
      "actions": [
        "security.rate_limit_denied"
      ],
      "emitters": [
        "database/migrations/0024_create_rate_limit_buckets.sql"
      ],
      "implementation_status": "implemented",
      "limitations": [
        "Only stable action, UTC time, correlation and source ID are projected. No key hash, IP, route, dimension or identifier."
      ]
    }
  ],
  "excluded_sources": {
    "execution_state_transitions": "Represented by execution events; no duplicate projection.",
    "identity_login_attempts": "Transient abuse-control state; identifier/IP hashes are not exported.",
    "stdout": "Technical logs; separate collection and policy.",
    "metrics": "Aggregates, not per-action audit events.",
    "feedback_events": "Immutable product history; creation and state changes are atomically mirrored into identity_access_events without feedback content.",
    "graylog_delivery_history": "Private immutable collector delivery trail; deliberately excluded to prevent recursion."
  },
  "coverage_findings": [
    {
      "journey": "evidence-download",
      "gap": "Authorized downloads had no audit event.",
      "resolution": "artifact.export_prepared after authorization and file validation, before FileResponse; no filename or path; not a receipt by the client."
    },
    {
      "journey": "audit-export",
      "gap": "No functional export or audit of export requests/results.",
      "resolution": "Explicit permission, bounded export, append-only requested/succeeded/failed events; no recursive export."
    },
    {
      "journey": "historical-attribution",
      "gap": "Some legacy sources omit actor UUID or correlation, and global identity events lack organization.",
      "resolution": "Preserve null/unknown and global-only scope; never infer historical actors or organizations from current memberships."
    }
  ],
  "capabilities": {
    "authentication": {
      "status": "implemented",
      "source": "identity_access_events",
      "actions": [
        "auth.login_succeeded",
        "auth.login_failed",
        "auth.login_rate_limited",
        "auth.logout",
        "auth.logout_others",
        "auth.logout_all",
        "auth.refresh_reused",
        "authorization.denied"
      ]
    },
    "smart_office_rpa": {
      "status": "not_implemented",
      "future_fields": [
        "operation_id",
        "started_at",
        "finished_at",
        "technical_actor_id",
        "operation",
        "duration_ms",
        "correlation_id",
        "outcome"
      ],
      "prohibited_fields": [
        "content",
        "files",
        "business_payload"
      ]
    },
    "llm_quality_explanation": {
      "status": "implemented",
      "source": "observability_events",
      "model": "qwen3:4b-instruct",
      "executor": "synergia-api",
      "tool": "none",
      "tokens": "not_available",
      "scope": "authenticated synthetic scenarios; explicit local-model activation"
    },
    "llm_autonomous_tools": {
      "status": "not_implemented",
      "future_fields": [
        "proposal_id",
        "model_version",
        "executor",
        "tool",
        "duration_ms",
        "tokens",
        "outcome",
        "fallback"
      ],
      "prohibited_fields": [
        "prompt",
        "response",
        "evidence",
        "tool_arguments"
      ]
    },
    "container_technical_logs": {
      "status": "external_collection_pending_approval",
      "stream": "separate from audit",
      "allowed": "only sanitized synergia JSON; never raw container stdout/stderr"
    }
  }
}
