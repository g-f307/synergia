{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "diagnoses",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "status": {
      "enum": [
        "completed",
        "insufficient_evidence"
      ]
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurrence_code",
          "category",
          "summary",
          "probable_cause",
          "verification_action",
          "confidence",
          "human_review_required",
          "evidence_ids"
        ],
        "properties": {
          "occurrence_code": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "category": {
            "enum": [
              "reading",
              "layout",
              "completeness",
              "format",
              "consistency",
              "reference",
              "unknown"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "probable_cause": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "description"
            ],
            "properties": {
              "kind": {
                "const": "hypothesis"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "verification_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "human_review_required": {
            "const": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev-[0-9]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "maxItems": 100
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 20
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergia.local/schemas/ai-quality-diagnosis-v2-output.schema.json"
}
