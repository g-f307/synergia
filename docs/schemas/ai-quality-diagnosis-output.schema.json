{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergia.local/schemas/ai-quality-diagnosis-output.schema.json",
  "title": "AI quality diagnosis output",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "status", "diagnoses", "open_questions"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "insufficient_evidence"]},
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["diagnosis_id", "occurrence_code", "summary", "impact", "verification_action", "evidence_ids"],
        "properties": {
          "diagnosis_id": {"type": "string", "pattern": "^quality:[a-zA-Z0-9_.-]+$"},
          "occurrence_code": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "verification_action": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "open_questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
