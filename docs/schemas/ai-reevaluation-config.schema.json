{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergia.local/schemas/ai-reevaluation-config.schema.json",
  "title": "Frozen local reevaluation configuration (issue 148)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "mode",
    "split",
    "repetitions",
    "warmup_attempts",
    "prompt",
    "model",
    "model_digest",
    "runtime_version",
    "endpoint",
    "think",
    "processor",
    "keep_alive_seconds",
    "request_timeout_seconds",
    "attempt_timeout_seconds",
    "options"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "kind": {
      "enum": [
        "quality",
        "operational"
      ]
    },
    "mode": {
      "enum": [
        "baseline",
        "agent"
      ]
    },
    "split": {
      "enum": [
        "development",
        "evaluation"
      ]
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "warmup_attempts": {
      "type": "integer",
      "const": 1
    },
    "prompt": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+\\.txt$"
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:/-]{1,160}$"
    },
    "model_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "endpoint": {
      "type": "string"
    },
    "think": {
      "type": "boolean"
    },
    "processor": {
      "enum": [
        "cpu_only",
        "automatic_acceleration"
      ]
    },
    "keep_alive_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 900
    },
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "attempt_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num_ctx",
        "num_predict",
        "temperature",
        "seed",
        "num_thread"
      ],
      "properties": {
        "num_ctx": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 32768
        },
        "num_predict": {
          "type": "integer",
          "minimum": 128,
          "maximum": 8192
        },
        "num_thread": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
