{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergia.local/schemas/ai-quality-diagnosis-input.schema.json",
  "title": "AI quality diagnosis input",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "execution", "occurrences"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_id", "status", "pipeline_version", "rule_catalog_version", "counts"],
      "properties": {
        "execution_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "pipeline_version": {"type": "string", "minLength": 1},
        "rule_catalog_version": {"type": "string", "minLength": 1},
        "counts": {"$ref": "#/$defs/counts"}
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "severity", "code", "reason", "details"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["error", "warning"]},
          "code": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "workorder_number": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "sheet_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "row_number": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
          "column_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "details": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "expected_value": {"anyOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}]},
              "received_value": {"anyOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}]},
              "constraint": {"anyOf": [{"type": "string", "maxLength": 300}, {"type": "null"}]},
              "source_name": {"anyOf": [{"type": "string", "maxLength": 160}, {"type": "null"}]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "rows_read", "errors", "warnings"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "rows_read": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      }
    }
  }
}
